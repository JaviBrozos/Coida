<?xml version="1.0" encoding="utf-8"?>
<!--
    Icono adaptativo (API 26+). Fondo marino de marca y delante solo la D, ya
    dibujada dentro de la zona segura: sin inset y sin un segundo cuadrado, que
    aparecía al cambiar de máscara o con el paralaje del launcher. Para API 24-25
    están los PNG de mipmap-*dpi.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
