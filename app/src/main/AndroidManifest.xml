<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Llamar a un contacto fijado con una sola pulsación. Sin este permiso (o si
        se deniega) la casilla abre el marcador con el número ya puesto.
    -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- El permiso de llamar no debe dejar fuera de Play a tablets sin teléfono. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!--
        La foto que cada contacto guardado en Coida tiene en la agenda (D-57). Se
        pide al añadir un contacto, con el familiar delante, y solo se consultan los
        números guardados aquí, nunca la agenda entera. Sin él, salen las iniciales.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
        Este manifiesto es el que se publica: solo esos dos permisos. Lo del
        asistente de voz (micrófono, internet y el motor de voz) vive en
        src/debug/AndroidManifest.xml, porque el asistente no sale en la versión
        pública (D-63).
    -->

    <!--
        Visibilidad de paquetes (Android 11+ / API 30).
        Sin este bloque el PackageManager no nos deja ver el resto de apps del
        dispositivo y el grid de favoritos saldría vacío. Declaramos solo lo que
        Coida necesita resolver, en lugar de pedir QUERY_ALL_PACKAGES.
    -->
    <queries>
        <!-- Todas las apps que se pueden abrir desde un lanzador. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Llamadas: el historial de la app de teléfono (D-65)... -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data
                android:mimeType="vnd.android.cursor.dir/calls"
                android:scheme="content" />
        </intent>
        <!-- ...y, si no tiene, su teclado. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <!-- Emergencias: el teléfono con el 112 ya marcado (D-51). -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- Mensajes -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MESSAGING" />
        </intent>
        <!-- Cámara -->
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <!-- Contactos -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CONTACTS" />
        </intent>
        <!--
            Apps recomendadas y la tienda. Ya las cubre la consulta de LAUNCHER de
            arriba, pero se declaran para que quede claro que Coida las busca.
        -->
        <package android:name="com.whatsapp" />
        <package android:name="com.sofascore.results" />
        <package android:name="com.android.vending" />
        <!-- Ficha de una app en la tienda (market://). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Coida"
        android:usesCleartextTraffic="false">

        <!--
            Actividad de inicio.
            · HOME + DEFAULT  -> el sistema ofrece Coida como pantalla de inicio.
            · LAUNCHER        -> además aparece en el cajón de aplicaciones, lo que
                                 resulta cómodo mientras se desarrolla. Se puede
                                 quitar cuando Coida sea el lanzador definitivo.
            · singleTask + stateNotNeeded + excludeFromRecents es la configuración
              habitual de un lanzador: pulsar Inicio siempre vuelve a esta misma
              instancia y no deja tarjeta en "recientes".
        -->
        <activity
            android:name=".launcher.LauncherActivity"
            android:configChanges="keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Coida">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
