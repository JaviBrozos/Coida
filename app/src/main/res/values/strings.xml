    <!--
        Ajustes → Asistente de voz (CU-15). Lo lee el familiar. Se habla de «un
        servicio externo», sin nombrar al proveedor, para que cambiarlo no obligue a
        reescribir los textos (D-25).
    -->
    <string name="assistant_settings_subtitle">Un botón redondo en el inicio para pedir cosas hablando</string>
    <string name="assistant_settings_privacy">Para entender lo que se le dice, la voz se envía por internet a un servicio externo de inteligencia artificial. Solo le llegan la voz y los nombres de contactos y casillas, nunca los números de teléfono. En el móvil no se guarda nada.</string>
    <string name="assistant_settings_switch">Botón del asistente en el inicio</string>
    <string name="assistant_settings_switch_subtitle">Al encenderlo se pide permiso para usar el micrófono</string>
    <string name="assistant_settings_mic_denied">Sin permiso del micrófono el asistente no puede oír. Vuelve a encender el interruptor para pedirlo, o dalo en los ajustes de Android.</string>
    <string name="assistant_settings_mode">Cuando le pida algo</string>
    <string name="assistant_mode_act">Lo hace</string>
    <string name="assistant_mode_guide">Explica cómo</string>
    <string name="assistant_settings_act_note">Antes de llamar o abrir algo, siempre pregunta y espera a que se pulse «Sí».</string>
    <string name="assistant_settings_guide_note">Explica los pasos de uno en uno y, al acabar, marca en el inicio el botón que hay que pulsar.</string>
    <string name="assistant_settings_try">Probar el asistente</string>
    <string name="assistant_settings_try_disabled">Para probarlo, enciende antes el botón del asistente.</string>
